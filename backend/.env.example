# Copy to backend/.env. Local startup reads this file automatically. Real environment variables take precedence.
SPRING_PROFILES_ACTIVE=live
FRONTEND_ORIGIN=http://localhost:5173
AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/
AUTH0_AUDIENCE=https://lionpathway-api
TIGER_DATABASE_URL=jdbc:postgresql://YOUR-HOST:YOUR-PORT/tsdb?sslmode=require
TIGER_DATABASE_USER=tsdbadmin
TIGER_DATABASE_PASSWORD=replace-me
GEMINI_API_KEY=replace-me
# Set an available model in your Google AI Studio project.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Planning / what-if / comparison questions go to Luminal when a key is set; otherwise everything uses Gemini.
# Assumes an OpenAI-compatible /chat/completions endpoint. Adjust the URL and model to match your Luminal account.
LUMINAL_API_KEY=
LUMINAL_BASE_URL=https://flash.luminal.cloud/v1
LUMINAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Optional Google Search grounding model; defaults to GEMINI_MODEL. Must support google_search.
# Uses the same Gemini API key; provider search charges may apply.
GEMINI_SEARCH_MODEL=gemini-3.5-flash-lite
