# Copy to backend/.env. Local startup reads this file automatically. Real environment variables take precedence.
SPRING_PROFILES_ACTIVE=live
FRONTEND_ORIGIN=http://localhost:5173
AUTH0_ISSUER=https://YOUR-TENANT.us.auth0.com/
AUTH0_AUDIENCE=https://lionpathway-api
TIGER_DATABASE_URL=jdbc:postgresql://YOUR-HOST:YOUR-PORT/tsdb?sslmode=require
TIGER_DATABASE_USER=tsdbadmin
TIGER_DATABASE_PASSWORD=replace-me
GEMINI_API_KEY=replace-me
# Set an available model in your Google AI Studio project.
GEMINI_MODEL=gemini-3.8-flash
